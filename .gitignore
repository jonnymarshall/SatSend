# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Playwright auth session (contains session cookies — never commit)
auth_state.json

# Playwright MCP session artifacts (logs, screenshots, snapshots)
.playwright-mcp/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Claude hook state markers (local, machine-specific)
.claude/.state/

# third-party agent skills (local tooling, not product code)
.opencode/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/

# test-automation local state (counters etc.)
test-automation/.state.json
