# SatSend environment variables
#
# Copy to .env.local and fill in. Test/dev project only — never point a local
# .env.local at the production database (see AGENTS.md).

# --- Supabase (client-safe; exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only; NEVER expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Bitcoin network ---
# DANGER: the code defaults this to "mainnet" when unset. A run pointed at the
# wrong network caused a real detection failure — always set it explicitly.
NEXT_PUBLIC_BTC_NETWORK=testnet4

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=SatSend <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=

# --- Cron auth ---
CRON_SECRET=

# --- Site/links (first non-empty wins when building absolute URLs) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Test-automation harness only (dev tooling; never shipped) ---
SATSEND_APP_URL=http://localhost:3000
SATSEND_NETWORK=testnet4
TESTNET_WALLET_MNEMONIC=
MAINNET_WALLET_MNEMONIC=
MEMPOOL_TESTNET4_URL=https://mempool.space/testnet4
MEMPOOL_MAINNET_URL=https://mempool.space
